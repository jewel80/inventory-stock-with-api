# Normalize line endings repository-wide.
# Critical: shell scripts run inside Linux containers MUST keep LF endings
# (CRLF breaks sh/dash/bash in the image — e.g. `set -eu\r` errors).

* text=auto

# Shell + container scripts: force LF everywhere (even on Windows checkouts).
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerignore  text eol=lf
docker-compose*.yml text eol=lf
.env*           text eol=lf
.github/**/*.yml    text eol=lf

# PowerShell scripts: Windows convention (CRLF).
*.ps1           text eol=crlf

# Treat these as binary (never normalize).
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
