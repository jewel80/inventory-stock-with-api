# Production environment (reference values).
# These are PLACEHOLDERS — never commit real credentials.
# In real production, inject secrets via the orchestrator / Docker secrets /
# GitHub Actions secrets. docker-compose.yml overrides these with interpolation.

NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL="postgresql://inventory:CHANGE_ME_PASSWORD@postgres:5432/inventorystock"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
SUPPLIER_API_URL="https://dummyjson.com"
PORT=8000
FRONTEND_URL="https://your-frontend-domain.example"
