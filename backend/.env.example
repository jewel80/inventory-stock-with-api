# =============================================================================
# Backend environment variables — TEMPLATE.
# Copy to `.env` for local (non-Docker) development:  cp .env.example .env
#
# In Docker these are injected by docker-compose.yml via variable
# interpolation; this file is for running `npm run dev` directly on the host.
# Never commit real secrets. Only .env.example/.env.development/.env.production
# (placeholders) are tracked.
# =============================================================================

# PostgreSQL connection string.
# - Local non-Docker dev: point at your host Postgres.
# - Docker dev/prod: use the service DNS name `postgres` (set by compose).
DATABASE_URL="postgresql://inventory:inventory_secret@postgres:5432/inventorystock"

# JWT signing secret. MUST be a long, random string in production (>= 32 chars).
JWT_SECRET="change-me-to-a-long-random-secret"

# External supplier API (product catalog source).
SUPPLIER_API_URL="https://dummyjson.com"

# Port the Express server listens on.
PORT=8000

# Comma-separated list of allowed CORS origins (the frontend URL(s)).
FRONTEND_URL="http://localhost:9000"

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Node runtime environment: development | production
NODE_ENV=development
