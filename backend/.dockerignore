# ── Version control & metadata ────────────────────────────────────────────────
.git
.gitignore

# ── Dependencies (installed inside the image via npm ci) ──────────────────────
node_modules

# ── Build output & generated artifacts ────────────────────────────────────────
dist
build
coverage

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Secrets — NEVER bake environment files into the image ─────────────────────
.env
.env.*

# ── Tests & tooling (not needed in the production image) ──────────────────────
src/tests
jest.config.js
.eslintrc.json

# ── Docker metadata ───────────────────────────────────────────────────────────
Dockerfile
.dockerignore

# ── Editor / OS cruft ─────────────────────────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db

# ── Docs ──────────────────────────────────────────────────────────────────────
README.md
*.md
