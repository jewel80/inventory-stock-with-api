# =============================================================================
# Compose interpolation variables (read by docker-compose.yml).
# Copy to `.env` at the repo root to override the defaults baked into compose:
#     cp .env.example .env
# Then edit values as needed.
# =============================================================================

# PostgreSQL container credentials (used by both the postgres service and the
# backend's DATABASE_URL so they can never drift).
POSTGRES_DB=inventorystock
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory_secret

# Backend application
JWT_SECRET=change-me-to-a-long-random-secret
SUPPLIER_API_URL=https://dummyjson.com
FRONTEND_URL=http://localhost:9000
LOG_LEVEL=info
