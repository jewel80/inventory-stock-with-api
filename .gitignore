# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/

# ── Secrets — NEVER commit real environment files ─────────────────────────────
# Only placeholder examples are tracked (.env.example / .env.development / .env.production).
.env
.env.local
.env.*.local
!.env.example
!.env.development
!.env.production

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# Lockfiles are intentionally committed — do NOT gitignore package-lock.json
